[Unit]
Description=DX-M1 phone vision app (photo/video -> DEEPX DX-M1 -> boxes / stick figures)
After=network-online.target
Wants=network-online.target

[Service]
User=zach
WorkingDirectory=/home/zach/dx-m1-phone-app
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8090
ExecStart=/mnt/jumpdata/accelerators/dx_m1/dx-runtime/venv-dx-runtime/bin/python3 /home/zach/dx-m1-phone-app/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
